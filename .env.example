# ==============================================================================
# UrbanTwin Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=UrbanTwin
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL + PostGIS Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=urbantwin
DB_PASSWORD=urbantwin_secret
DB_NAME=urbantwin_db
DATABASE_URL=postgresql+psycopg2://urbantwin:urbantwin_secret@localhost:5432/urbantwin_db
ASYNC_DATABASE_URL=postgresql+asyncpg://urbantwin:urbantwin_secret@localhost:5432/urbantwin_db

# External APIs
OPENAQ_API_KEY=your_openaq_api_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Spatial Configuration (Pune, India)
PUNE_BBOX_MIN_LAT=18.40
PUNE_BBOX_MAX_LAT=18.65
PUNE_BBOX_MIN_LON=73.75
PUNE_BBOX_MAX_LON=74.05
H3_RESOLUTION=7

# Scheduler Configuration
ENABLE_SCHEDULER=False
POLLING_INTERVAL_MINUTES=60

# Data Mode (real | synthetic)
DATA_MODE=synthetic
DATA_DIR=data

TOMTOM_API_KEY=m18useAen2sKyUZVqwPNa2xHSquohHPS
